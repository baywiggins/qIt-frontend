    "/rooms/{code}/events": {
      "get": {
        "operationId": "roomEvents",
        "x-no-client": true,
        "description": "WebSocket upgrade with a single-use 30-second ticket. Subscribe-before-snapshot; bounded buffers; connection renewed every five minutes. JSON messages follow RoomEvent. A gap or reconnect requires a fresh snapshot.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticket",
