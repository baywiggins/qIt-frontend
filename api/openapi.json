            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [],
        "responses": {
          "101": {
            "description": "WebSocket stream of RoomEvent"
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
